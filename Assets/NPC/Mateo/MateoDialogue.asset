  npcName: Mateo
  npcPortrait: {fileID: 21300000, guid: c1b3d7cb4b37a0442a1f5d96a599a92c, type: 3}
  dialogueLines:
  - "\xA1Hola! ! <link=\"Bienvenido\"><u>Bienvenido</u></link> a San Paloma!"
  - "<link=\"Me llamo\"><u>Me llamo</u></link> Mateo. \xBFC\xF3mo te llamas t\xFA?"
  - "\xA1<link=\"Mucho gusto\"><u>Mucho gusto</u></link>, Justin!"
  - "Es un placer conocerte. \xBF<link=\"De d\xF3nde eres\"><u>De d\xF3nde eres</u></link>?"
  - "\xA1Genial! <link=\"Me alegra\"><u>Me alegra</u></link> que est\xE9s aqu\xED."
  - "<link=\"Necesitas ayuda\"><u>\xBFNecesitas ayuda?</u></link> \xBFA d\xF3nde
    quieres ir?"
  - "El Restaurante El Sol est\xE1 todo recto."
  - "\xBFEntendiste? \xBFD\xF3nde est\xE1 el restaurante?"
  - "\xA1Muy bien! Ahora puedes explorar San Paloma. Recuerda: \"Hola\", \"me llamo\",
    \"\xBFd\xF3nde est\xE1?\" y \"gracias\" te van a <link=\"Servir\"><u>servir</u></link>
    mucho."
  - "\xA1De nada! Nos vemos pronto. \xA1Divi\xE9rtete explorando!"
  - "\xA1En espa\xF1ol, por favor!"
  - "\xA1Casi! En espa\xF1ol decimos \u201CSoy de Ravenport\u201D o \u201CVengo de
    Ravenport\u201D."
  - "\xA1Casi! Para decir \u201CWhere is the restaurant?\u201D en espa\xF1ol, usamos
    \u201C\xBFD\xF3nde est\xE1 el restaurante?\u201D"
  - "\xA1Casi! \u201CTodo recto\u201D significa \u201Cstraight ahead\u201D."
  autoProgressLines: 00000000000000000000000000000000000000
  endDialogueLines: 000000000000000000010000000000000000
