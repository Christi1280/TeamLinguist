  npcName: Diego
  npcPortrait: {fileID: 21300000, guid: 8d455a612a8681b47a78b89225833505, type: 3}
  dialogueLines:
  - "<link=\"\xBFEntendiste?\"><u>\xBFEntendiste?</u></link> \xBFQu\xE9 incluye el
    men\xFA del d\xEDa?"
  - "\xA1Exacto! Muy bien."
  - "\xBFQu\xE9 te gustar\xEDa <link=\"pedir\"><u>pedir</u></link>? \xBFEl men\xFA
    del d\xEDa o algo de <link=\"la carta\"><u>la carta</u></link>?"
  - "\xA1Perfecto! <link=\"Enseguida\"><u>Enseguida</u></link> te traigo la sopa.
    \xBFQuieres algo de <link=\"beber\"><u>beber</u></link>?"
  - "Muy bien. <link=\"\xBFAlgo m\xE1s?\"><u>\xBFAlgo m\xE1s?</u></link>"
  - "\xA1Genial! Enseguida vuelvo. Y recuerda: si necesitas algo, solo di \u201C\xA1Diego!\u201D "
  - "Recuerda: sopa, plato principal y postre. \xBFQuieres intentarlo otra vez?"
  - "\xA1Todav\xEDa no has pedido comida! \xBFQu\xE9 te gustar\xEDa comer?"
  - "\xA1Casi! Para pedir agua, puedes decir \"un vaso de agua, por favor\"."
  autoProgressLines: 
  endDialogueLines: 000000000001
