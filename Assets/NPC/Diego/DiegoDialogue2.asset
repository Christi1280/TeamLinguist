  npcPortrait: {fileID: 21300000, guid: 8d455a612a8681b47a78b89225833505, type: 3}
  dialogueLines:
  - "\xBFEntendiste? \xBFQu\xE9 incluye el men\xFA del d\xEDa?"
  - "\xA1Exacto! Muy bien."
  - "\xBFQu\xE9 te gustar\xEDa pedir? \xBFEl men\xFA del d\xEDa o algo de la carta?"
  - "Recuerda. sopa, plato principal y postre. \xBFQuieres intentarlo otra vez?"
  - "\xA1Perfecto! Ahora te traigo todo. \xBFAlgo m\xE1s?"
  - "\xA1Genial! Enseguida vuelvo. Y recuerda: si necesitas algo, solo di \u201C\xA1Diego!\u201D "
