  npcName: Justin
  npcPortrait: {fileID: 21300000, guid: e556253d927940c44b781287de136d09, type: 3}
  dialogueLines:
  - 'Funny, because you''re usually the one getting us into trouble. '
  - 'Yeah, yeah. You''re late, by the way. '
  - 'Alright. Now tell me. What did you drag me all the way out here for? '
  - ' ...A book? '
  - 'Am I supposed to know who that is? '
  - Okay... and?
  - 'And you think this book is going to lead us to them? '
  - 'Where did you even get this? '
  - 'Uh-huh. '
  - 'What''s that supposed to be? '
  - 'A cipher disc? '
  - 'So you''ve tried using it? '
  - 'Maybe you''re supposed to follow the instructions. '
  - 'Alright. Let me take a look. '
  autoProgressLines: 
  endDialogueLines: 
